# Server
PORT=5000

# MongoDB (Atlas URI)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/villa-booking

# JWT
JWT_SECRET=change-me
JWT_EXPIRE=30d

# Cloudinary (used for Landing CMS image uploads)
# Copy real values from your Cloudinary dashboard into .env (gitignored).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (payment links for booking payments + webhook verification)
# Copy from the Razorpay dashboard into .env (gitignored).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
